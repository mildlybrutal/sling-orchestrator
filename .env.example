# Copy to .env and fill in. Read by "sling serve" (export these first, e.g. `set -a; . ./.env; set +a`).
SLING_WEBHOOK_SECRET=   # required, at least 16 chars: openssl rand -hex 32
SLING_REPO=             # required, owner/name, e.g. mildlybrutal/sling
SLING_BRANCH=main       # optional
SLING_LISTEN=127.0.0.1:9000   # optional
SLING_STATUS_TOKEN=     # optional, at least 16 chars: enables GET /deploys (send as "Authorization: Bearer <token>")
SLING_DATA_DIR=         # optional: where history.db lives (default ~/.local/state/sling)
# Public HTTPS (leave SLING_DOMAIN empty for local mode). Every sling command must use the same values.
SLING_DOMAIN=           # e.g. app.example.com; DNS must point at this server
SLING_TLS=              # acme (default) or internal (Caddy's own CA, for testing)
SLING_ACME_EMAIL=       # optional
SLING_WEBHOOK_PORT=     # default 9000: where sling serve listens for Caddy
SLING_PUBLIC_BIND=      # default 0.0.0.0; 127.0.0.1 to test without exposing 80/443
